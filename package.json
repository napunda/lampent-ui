{
  "name": "lampent-ui",
  "version": "0.1.0",
  "description": "Biblioteca de componentes Vue 3 com Tailwind CSS",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/lampent-ui.cjs",
  "module": "./dist/lampent-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/lampent-ui.js",
      "require": "./dist/lampent-ui.cjs"
    },
    "./style.css": "./dist/lampent-ui.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run build",
    "docs:dev": "pnpm --filter lampent-ui-docs docs:dev",
    "docs:build": "pnpm --filter lampent-ui-docs docs:build",
    "docs:preview": "pnpm --filter lampent-ui-docs docs:preview"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui",
    "tailwindcss"
  ],
  "license": "MIT",
  "peerDependencies": {
    "vue": "^3.5.0",
    "@floating-ui/vue": "^2.0.0"
  },
  "dependencies": {
    "@floating-ui/vue": "^2.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.2",
    "vitepress": "2.0.0-alpha.17",
    "vue": "^3.5.34",
    "vue-tsc": "^3.2.8"
  }
}
